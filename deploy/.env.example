POSTGRES_PASSWORD=
# Un rôle PostgreSQL par base (sans SUPERUSER) : Directus, LiteLLM, Umami. Générés par deploy/init-env.sh ; pour un cluster
# déjà initialisé, deploy/harden-db-roles.sh les ajoute ici et crée les rôles (docs/infra.md).
DIRECTUS_DB_PASSWORD=
LITELLM_DB_PASSWORD=
UMAMI_DB_PASSWORD=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
NEXORA_APP_ADMIN_TOKEN=
NEXORA_VAULT_MASTER_KEY=
PC1_UPSTREAM_URL=
PC1_UPSTREAM_KEY=
DIRECTUS_URL=
DIRECTUS_READER_TOKEN=
DIRECTUS_PUBLISHER_TOKEN=
DIRECTUS_EDITOR_EMAIL=
DIRECTUS_EDITOR_PASSWORD=
DIRECTUS_REVIEWER_EMAIL=
DIRECTUS_REVIEWER_PASSWORD=
NEXORA_PREVIEW_SECRET=

# --- Formulaire de contact (S3) ---
# Secret des défis anti-abus ALTCHA (32 caractères au moins). Facultatif : à défaut, dérivé de NEXORA_APP_ADMIN_TOKEN.
NEXORA_ALTCHA_SECRET=
# Courriel de notification à l'équipe (worker). En développement : Mailpit (127.0.0.1:1026).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
# Mot de passe SMTP : jamais ici en production ; chemin d'un secret Docker.
SMTP_PASSWORD_FILE=
SMTP_FROM=
# Une ou plusieurs adresses séparées par des virgules.
CONTACT_NOTIFY_TO=

# --- Site et worker (production) : voir docs/guide-operateur.md §3. Les lignes commentées n'ont pas de valeur par défaut sûre. ---
# Signe les sessions et jetons Better Auth (32 caractères au moins). Généré par deploy/init-env.sh.
# BETTER_AUTH_SECRET=
# Base « app » (site, worker, migrations).
# DATABASE_URL=postgres://nexora:<mot de passe>@<hôte>:5432/app
# Adresse publique du site (https) AVANT le build et le démarrage ; SITE_ENV=production rend le site indexable.
# SITE_URL=https://www.exemple.ca
# SITE_ENV=production
# Courriels transactionnels du site (vérification de courriel) ; le défaut est Mailpit local : rien ne part en production.
# SMTP_URL=smtp://<hôte>:587
# MAIL_FROM=Nexora AI <ne-pas-repondre@exemple.ca>
# Adresse INTERNE du site, la même pour Directus (revalidation) et le worker (agents, passerelle) : obligatoire en production.
# NEXORA_APP_INTERNAL_URL=http://site:3500
# Adresse interne de LiteLLM (passerelle /v1 du site et sonde de santé du worker).
# LITELLM_BASE_URL=http://litellm:4000
# Instantanés du CMS servis si Directus tombe : volume persistant.
# CMS_SNAPSHOT_DIR=/var/lib/nexora/cms-snapshots
# SMTP du worker : STARTTLS obligatoire (à poser avec un vrai SMTP sur le port 587 ; Mailpit n'a pas de TLS).
# SMTP_REQUIRE_TLS=true
# Directus : adresse publique et origine CORS (par défaut http://localhost:8456, développement seulement).
# DIRECTUS_PUBLIC_URL=https://cms.exemple.ca
# DIRECTUS_CORS_ORIGIN=https://cms.exemple.ca
# Sauvegarde (deploy/backup.sh, deploy/restore.sh) : noms des conteneurs (défauts de développement nexorasite-db-1 et
# nexorasite-directus-1), clés de chiffrement (obligatoire) et de signature (fichiers 0400 hors du dépôt).
# NEXORA_DB_CONTAINER=nexorasite-db-1
# NEXORA_DIRECTUS_CONTAINER=nexorasite-directus-1
# NEXORA_BACKUP_ENCRYPT_KEY_FILE=/etc/nexora/backup-enc.key
# NEXORA_BACKUP_SIGNING_KEY_FILE=/etc/nexora/backup-sign.key

# --- Durcissement de Directus et de la pile (docs/infra.md, docs/cms.md §10) ---
# DOIT valoir true en production (PUBLIC_URL en https) : témoins de session « Secure ». false pour le développement seulement.
# DIRECTUS_COOKIE_SECURE=true
# Derrière le proxy HTTPS : uniquelocal (réseaux privés Docker). Jamais « true » ; false si Directus est joint directement.
# DIRECTUS_TRUST_PROXY=uniquelocal
# En-tête portant l'adresse du client si le proxy n'utilise pas X-Forwarded-For (défaut : false).
# DIRECTUS_IP_CUSTOM_HEADER=false
# Taille maximale d'un fichier envoyé à Directus (défaut 20mb).
# DIRECTUS_MAX_UPLOAD_SIZE=20mb
# Plafonds de mémoire des conteneurs (défauts : 2g, 1g, 2g).
# NEXORA_DB_MEM_LIMIT=2g
# NEXORA_DIRECTUS_MEM_LIMIT=1g
# NEXORA_LITELLM_MEM_LIMIT=2g
# 2FA exigée des personnes (Éditeur, Relecteur, Administrateur) par cms/scripts/apply.ts ; 0 ou false pour le développement.
# CMS_ENFORCE_TFA=true
# Connexion des scripts cms/scripts : préférer DIRECTUS_ADMIN_TOKEN ; un administrateur à 2FA fournit DIRECTUS_ADMIN_OTP.
# DIRECTUS_ADMIN_TOKEN=
# DIRECTUS_ADMIN_OTP=

# --- Production : deploy/compose.prod.yml (secrets Docker). Ce fichier n'a QUE des chemins vers des fichiers 0400. ---
# Chaque fichier contient le secret SANS retour à la ligne final (printf '%s' valeur > fichier).
# POSTGRES_PASSWORD_FILE=/etc/nexora/secrets/postgres_password
# DIRECTUS_DB_PASSWORD_FILE=/etc/nexora/secrets/directus_db_password
# LITELLM_DB_PASSWORD_FILE=/etc/nexora/secrets/litellm_db_password
# UMAMI_DB_PASSWORD_FILE=/etc/nexora/secrets/umami_db_password
# DIRECTUS_SECRET_FILE=/etc/nexora/secrets/directus_secret
# DIRECTUS_ADMIN_PASSWORD_FILE=/etc/nexora/secrets/directus_admin_password
# NEXORA_APP_ADMIN_TOKEN_FILE=/etc/nexora/secrets/nexora_app_admin_token
# LITELLM_MASTER_KEY_FILE=/etc/nexora/secrets/litellm_master_key
# LITELLM_SALT_KEY_FILE=/etc/nexora/secrets/litellm_salt_key
# Port de Directus sur la boucle locale de l'hôte (proxy HTTPS de l'hôte), défaut 8456.
# DIRECTUS_HOST_PORT=8456
