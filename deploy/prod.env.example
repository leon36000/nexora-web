# Exemple de deploy/prod.env (copié en /srv/nexora/deploy/prod.env sur la VM de production). AUCUN SECRET ici : seulement
# des chemins de fichiers (…_FILE) et des réglages publics. Les fichiers de secrets se créent avec deploy/prod-init.sh.

# --- Adresses (SITE_URL est figée à la compilation du site : la changer exige de reconstruire l'image) ---
SITE_URL=https://nexora-pile.tail0c55ff.ts.net
# Vide = site non indexable (noindex, Disallow: /). `production` seulement à l'ouverture au public (étape 20 du plan).
SITE_ENV=
DIRECTUS_PUBLIC_URL=https://nexora-pile.tail0c55ff.ts.net:8443
DIRECTUS_CORS_ORIGIN=https://nexora-pile.tail0c55ff.ts.net:8443
NEXORA_APP_INTERNAL_URL=http://site:3500
DIRECTUS_ADMIN_EMAIL=admin@nexora-pile.example.com

# --- Forge de dépôts de code (temporaire : GitLab, puis Gitspace). Lue au rendu : redémarrer le site suffit, sans reconstruire. ---
# Vide = https://pc4.tail0c55ff.ts.net (le GitLab privé de l'équipe, joignable sur le tailnet seulement).
GITSPACE_FORGE_URL=
# Gitspace est masqué du site public et de /compte tant que cette variable n'est pas « true » (voir docs/guide-operateur.md).
# GITSPACE_VISIBLE=false

# --- Secrets : dossier et groupe qui les lit (voir deploy/prod-init.sh) ---
NEXORA_SECRETS_DIR=/srv/nexora/secrets
NEXORA_SECRETS_GID=2001
POSTGRES_PASSWORD_FILE=/srv/nexora/secrets/postgres_password
DIRECTUS_DB_PASSWORD_FILE=/srv/nexora/secrets/directus_db_password
LITELLM_DB_PASSWORD_FILE=/srv/nexora/secrets/litellm_db_password
UMAMI_DB_PASSWORD_FILE=/srv/nexora/secrets/umami_db_password
DIRECTUS_SECRET_FILE=/srv/nexora/secrets/directus_secret
DIRECTUS_ADMIN_PASSWORD_FILE=/srv/nexora/secrets/directus_admin_password
NEXORA_APP_ADMIN_TOKEN_FILE=/srv/nexora/secrets/nexora_app_admin_token
LITELLM_MASTER_KEY_FILE=/srv/nexora/secrets/litellm_master_key
LITELLM_SALT_KEY_FILE=/srv/nexora/secrets/litellm_salt_key
DEEPINFRA_API_KEY_FILE=/srv/nexora/secrets/deepinfra_api_key
OPENROUTER_API_KEY_FILE=/srv/nexora/secrets/openrouter_api_key

# --- Courriel : PROVISOIRE (Mailpit interne, rien ne sort) tant qu'aucun SMTP n'existe ---
DIRECTUS_EMAIL_FROM=no-reply@nexora.test
DIRECTUS_SMTP_HOST=mailpit
DIRECTUS_SMTP_PORT=1025
SITE_SMTP_URL=smtp://mailpit:1025
MAIL_FROM=no-reply@nexora.test
WORKER_SMTP_HOST=mailpit
WORKER_SMTP_PORT=1025
CONTACT_NOTIFY_TO=equipe@nexora.test

# --- Nexora Creative (VM Creative) ---
NEXORA_SECRET_HOSTS_CREATIVE=192.168.1.122

# --- Pile ---
# Profils de Compose : navigateur WebPilot, Mailpit provisoire (retirer « mail-provisoire » avec un vrai SMTP).
NEXORA_PROFILES="webpilot-browser mail-provisoire"
# Images construites sur la VM (étiquette locale) ; ports de l'hôte : 3500 (site, boucle locale) et 80 (réseau local).
NEXORA_IMAGE_TAG=local
SITE_HOST_PORT=3500
FRONT_HTTP_PORT=80
DIRECTUS_HOST_PORT=8456

# --- VPS sur un Proxmox réel (docs/vps/EXPLOITATION-PC5.md) ---
# Hôte du Proxmox qui peut recevoir le jeton du Coffre (site ET worker), plage des VPS que le worker peut joindre en SSH.
NEXORA_SECRET_HOSTS_PROXMOX=192.168.1.106
NEXORA_OUTBOUND_ALLOW=192.168.1.106,10.77.0.0/24
# Clé publique SSH du worker (la privée est au Coffre : vps.worker_ssh_key).
VPS_WORKER_SSH_PUBLIC_KEY=
# Pile d'ESSAI seulement : simulateur Stripe interne (profil stripe-test) ; vide en vraie production.
STRIPE_TEST_MOCK_URL=
