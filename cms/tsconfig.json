{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["scripts/**/*.ts", "extensions-src/nexora-cms/src/**/*.ts"],
  "exclude": ["node_modules", "extensions-src/nexora-cms/dist"]
}
