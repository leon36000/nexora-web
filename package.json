{
  "name": "nexora-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "worker",
    "packages/*",
    "cms",
    "cms/extensions-src/*",
    "deploy"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "worker": "bun run --cwd worker start",
    "vault:rotate": "bun run --cwd web vault:rotate",
    "e2e": "bun scripts/e2e.ts",
    "guide:vps": "bun run --cwd worker guide:vps"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24",
    "@vitest/coverage-v8": "4.1.12",
    "playwright-core": "1.64.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "zod": "4.6.7",
    "vite": "8.3.5"
  }
}
