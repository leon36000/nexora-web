{
  "name": "nexora-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "worker",
    "packages/*",
    "cms",
    "cms/extensions-src/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "worker": "bun run --cwd worker start",
    "vault:rotate": "bun run --cwd web vault:rotate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24",
    "typescript": "^5",
    "vitest": "^3"
  },
  "packageManager": "bun@1.4.2"
}
